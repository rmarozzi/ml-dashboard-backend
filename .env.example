# ─── Database (Neon.tech) ─────────────────────────────────────────────────────
# Cole a connection string do Neon aqui (pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── JWT / Session ────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_string_aleatoria_longa

# ─── Admin bootstrap ─────────────────────────────────────────────────────────
# Usado na rota POST /auth/register para criar o primeiro admin
ADMIN_SECRET=troque_por_segredo_forte
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=senha_inicial_admin

# ─── Mercado Livre OAuth ──────────────────────────────────────────────────────
# Crie seu app em: https://developers.mercadolivre.com.br/
ML_CLIENT_ID=seu_app_id_aqui
ML_CLIENT_SECRET=seu_app_secret_aqui
# URL de callback: deve ser o URL do seu backend no Render + /auth/callback
ML_REDIRECT_URI=https://ml-dash-api.onrender.com/auth/callback

# ─── Frontend URL (para redirect OAuth) ───────────────────────────────────────
FRONTEND_URL=https://seu-projeto.vercel.app

# ─── CORS (separar múltiplas origens por vírgula) ─────────────────────────────
ALLOWED_ORIGINS=https://seu-projeto.vercel.app,http://localhost:3000
